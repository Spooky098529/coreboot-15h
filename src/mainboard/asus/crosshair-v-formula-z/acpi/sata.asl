/*
 * acpi/sata.asl -- SATA device definitions and hotplug handler
 *
 * Minimal setup required for AHCI / SATA operation.
 */

/* SATA timing mode buffer */
Name(SPTS, Buffer(0x07) { 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 })
Name(STTM, Buffer(0x14) {
	0x78, 0x00, 0x00, 0x00,  /* PIO mode 4 timing */
	0x78, 0x00, 0x00, 0x00,  /* PIO mode 4 timing */
	0x00, 0x00, 0x00, 0x00,
	0x00, 0x00, 0x00, 0x00,
	0x1F, 0x00, 0x00, 0x00   /* DMA + PIO flags */
})
