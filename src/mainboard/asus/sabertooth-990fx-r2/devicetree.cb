chip northbridge/amd/agesa/family15/root_complex
	device cpu_cluster 0 on
		chip cpu/amd/agesa/family15
			device lapic 10 on end
		end
	end
	device domain 0 on
		subsystemid 0x1043 0x8163 inherit
		chip northbridge/amd/agesa/family15
			device pci 18.0 on
				chip northbridge/amd/cimx/rd890
					device pci 0.0 on end # Host bridge
					device pci 0.1 off end # CLKCONFIG
					device pci 0.2 off end # IOMMU
					device pci 2.0 on end # GFX port 0 - PCIEX16_1 - Primary GPU slot
					device pci 3.0 off end # GFX port 1 - not wired
					device pci 4.0 on end # GPP port 0 - Onboard SATA
					device pci 5.0 on end # GPP port 1 - Onboard SATA
					device pci 6.0 off end # GPP port 2 - not wired
					device pci 7.0 off end # GPP port 3 - not wired
					device pci 9.0 on end # GPP port 4 - ASMedia Technology ASM1042 USB 3.0 Host [1b21:1042]
					device pci a.0 on end # GPP port 5 (PCIEX16_4 slot)
					device pci b.0 on end # GFX2 port 0 (PCIE16_3, 990FX secondary x16 GFX2)
					device pci c.0 off end # GFX2 port 1 (Disabled, can be rerouted for x8/x8 triple-SLI on PCIEx16_4)
					device pci d.0 on end # GPP2 port 0 (GPP3b core, PCIE16_2, x4)
					device pci 8.0 off end # NB/SB Link P2P bridge, hidden by design

					register "gpp1_configuration" = "0" # AAAA: PCIEX16_1 is x16, is never split.
					register "gpp2_configuration" = "0" # AAAA: PCIEX16_3 is x16 (port 11). Can be split with PCIEX16_4.
					register "gpp3a_configuration" = "6" # GPP111111: all six GPP3a ports used as x1
					register "port_enable" = "0x2E34"
				end # cimx/rd890
				chip southbridge/amd/cimx/sb800
					device pci 11.0 on end # SATA (AHCI, 6 ports)
					device pci 12.0 on end # USB OHCI
					device pci 12.2 on end # USB EHCI
					device pci 13.0 on end # USB OHCI
					device pci 13.2 on end # USB EHCI
					device pci 14.5 on end # USB OHCI
					device pci 16.0 on end # USB OHCI
					device pci 16.2 on end # USB EHCI
					device pci 14.6 off end # SB950 GBe MAC not used, onboard LAN is PCIe
					device pci 14.0 on # SMBus
						chip drivers/generic/generic #dimm 0-0-0
							device i2c 50 on end
						end
						chip drivers/generic/generic #dimm 0-0-1
							device i2c 51 on end
						end
						chip drivers/generic/generic #dimm 0-1-0
							device i2c 52 on end
						end
						chip drivers/generic/generic #dimm 0-1-1
							device i2c 53 on end
						end
					end # SMBus
					device pci 14.1 off end # IDE
					device pci 14.2 on end # HD Audio
					device pci 14.3 on # LPC bridge
						chip superio/ite/it8721f # ITE IT8721F
							# Use all 8 voltage inputs (VIN0-VIN7)
							register "ec.vin_mask"            = "VIN_ALL"

							# Temperature sensors
							# TMPIN1 (p90, CPU socket NTC)
							# TMPIN2 (p89, MB ambient NTC) NTC thermistor OT2 (MB ambient)
							# TMPIN3 (p88, NB die temp diode)
							register "TMPIN1.mode"            = "THERMAL_RESISTOR"
							register "TMPIN2.mode"            = "THERMAL_RESISTOR"
							register "TMPIN3.mode"            = "THERMAL_RESISTOR"

							# CPU fan control for FAN1/CPU_FAN
							# "SmartGuardian" mode driven by TMPIN1/CPU temp
							register "FAN1.mode"              = "FAN_SMART_AUTOMATIC"
							register "FAN1.smart.tmpin"       = "1"
							register "FAN1.smart.tmp_off"     = "40"
							register "FAN1.smart.tmp_start"   = "50"
							register "FAN1.smart.tmp_full"    = "85"
							register "FAN1.smart.tmp_delta"   = "2"
							register "FAN1.smart.pwm_start"   = "30"
							register "FAN1.smart.slope"       = "1"
							register "FAN1.smart.smoothing"   = "1"

							# Optional CPU fan control for FAN2/CPU_OPT
							# "SmartGuardian" mode driven by TMPIN2/MB temp
							register "FAN2.mode"              = "FAN_SMART_AUTOMATIC"
							register "FAN2.smart.tmpin"       = "2"
							register "FAN2.smart.tmp_off"     = "35"
							register "FAN2.smart.tmp_start"   = "45"
							register "FAN2.smart.tmp_full"    = "75"
							register "FAN2.smart.tmp_delta"   = "2"
							register "FAN2.smart.pwm_start"   = "30"
							register "FAN2.smart.slope"       = "1"
							register "FAN2.smart.smoothing"   = "1"

							# Chassis fan control for FAN3/CHA_FAN
							# "SmartGuardian" mode driven by TMPIN2/MB temp
							register "FAN3.mode"              = "FAN_SMART_AUTOMATIC"
							register "FAN3.smart.tmpin"       = "2"
							register "FAN3.smart.tmp_off"     = "35"
							register "FAN3.smart.tmp_start"   = "45"
							register "FAN3.smart.tmp_full"    = "75"
							register "FAN3.smart.tmp_delta"   = "2"
							register "FAN3.smart.pwm_start"   = "30"
							register "FAN3.smart.slope"       = "1"
							register "FAN3.smart.smoothing"   = "1"

							# FAN_CTL4/CHA_FAN2 is not configured for this model

							device pnp 2e.0 off end # FDC - no floppy drive
							device pnp 2e.1 on
								io 0x60 = 0x3f8
								irq 0x70 = 4
							end # COM1 - wired on header
							device pnp 2e.2 off end # COM2 - unused/not wired
							device pnp 2e.3 off end # PP - no parallel port
							device pnp 2e.4 on
								io 0x60 = 0x290
								io 0x62 = 0x298
								irq 0x70 = 0  # no interrupt - TODO: Confirm if HWM uses polling
							end # EC/HWM
							device pnp 2e.5 on
								io 0x60 = 0x60
								io 0x62 = 0x64
								irq 0x70 = 1
								irq 0x72 = 12
							end # KBC
							device pnp 2e.6 off end # MOUSE - already claimed by KBC (2e.5)
						end # superio
						chip drivers/pc80/tpm
							device pnp 4e.0 on end # Infineon TPM 2.0
						end # drivers/pc80/tpm - untested
					end # LPC
					device pci 14.4 on end # PCI bridge
					device pci 15.0 on end # SB PCIe 0 - PCIEX1_1 Slot
					device pci 15.1 on end # SB PCIe 1 - Realtek RTL8111/8168 Gigabit Ethernet [10ec:8168]
					device pci 15.2 on end # SB PCIe 2 - ASMedia Technology ASM1042 USB 3.0 Host [1b21:1042]
					device pci 15.3 on end # SB PCIe 3 - ASMedia Technology ASM1042 USB 3.0 Host [1b21:1042]

					register "gpp_configuration" = "4" # PCIe GPP lane config 1:1:1:1
					register "boot_switch_sata_ide" = "0" # 0=SATA primary, 1=IDE primary
				end # southbridge/amd/cimx/sb800
			end # D18F0
			device pci 18.1 on end
			device pci 18.2 on end
			device pci 18.3 on end
			device pci 18.4 on end
			device pci 18.5 on end
			device pci 18.6 off end
			device pci 18.7 off end

			# AGESA SPD address lookup (8-bit shifted: 0x50<<1=0xA0, 0x51<<1=0xA2, ...)
			register "spdAddrLookup" = "
			{
				{ {0xA0, 0xA2, 0x00, 0x00}, {0xA4, 0xA6, 0x00, 0x00} },
			}"
		end # northbridge/amd/agesa/family15
	end # domain 0
end # root_complex
