/*
 * acpi/usb_oc.asl -- USB overcurrent pin mappings
 *
 * TODO: Verify USB overcurrent pin assignments for this board.
 *       All OC pins default to 0 (no overcurrent protection).
 *       Needs pin review based on hardware.
 */

/* USB Overcurrent Mapping */
Name(UOM0, 0)  /* USB0 port 0 OC pin */
Name(UOM1, 0)  /* USB0 port 1 OC pin */
Name(UOM2, 0)  /* USB0 port 2 OC pin */
Name(UOM3, 0)  /* USB0 port 3 OC pin */
Name(UOM4, 0)  /* USB1 port 0 OC pin */
Name(UOM5, 0)  /* USB1 port 1 OC pin */
Name(UOM6, 0)  /* USB1 port 2 OC pin */
Name(UOM7, 0)  /* USB1 port 3 OC pin */
Name(UOM8, 0)  /* USB2 port 0 OC pin */
Name(UOM9, 0)  /* USB2 port 1 OC pin */
