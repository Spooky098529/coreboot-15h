config NORTHBRIDGE_AMD_CIMX_RD890
	bool
	default n
	select AMD_NB_CIMX

if NORTHBRIDGE_AMD_CIMX_RD890

config ENABLE_NB_CIMX_DEBUGGER
	bool "Enable CIMx Debugging"
	default n
	help
	  This option enables the AMD CIMX debugger and redirects it to the coreboot console.

	  Warning: Only enable this option when debuging or tracing AMD CIMX code.

config NORTHBRIDGE_AMD_CIMX_RD890_IOMMU
	bool "Enable IOMMU"
	default y

# RD890/990FX is PCIe Gen2 -- no CLKREQ# and no L1 Substates support
config PCIEXP_CLK_PM
	bool
	default n

config PCIEXP_L1_SUB_STATE
	bool
	default n

choice
	prompt "PCIe ASPM Support"
	default RD890_PCIE_ASPM_L1
	help
	  ASPM mode for RD890 NB PCIe ports. CIMx negotiates with each
	  endpoint and only enables modes both sides support. ASPM may
	  be enabled at boot by coreboot (see Devices) or by the OS.

config RD890_PCIE_ASPM_DISABLED
	bool "Disabled"

config RD890_PCIE_ASPM_L0S
	bool "L0s"

config RD890_PCIE_ASPM_L1
	bool "L1, balanced"

config RD890_PCIE_ASPM_L0S_AND_L1
	bool "L0s and L1"

config RD890_PCIE_ASPM_L0S_DOWNSTREAM
	bool "L0s downstream"

config RD890_PCIE_ASPM_L0S_DOWNSTREAM_AND_L1
	bool "L0s downstream and L1"

endchoice

config RD890_PCIE_ASPM_MODE
	hex
	default 0x00 if RD890_PCIE_ASPM_DISABLED
	default 0x01 if RD890_PCIE_ASPM_L0S
	default 0x02 if RD890_PCIE_ASPM_L1
	default 0x03 if RD890_PCIE_ASPM_L0S_AND_L1
	default 0x04 if RD890_PCIE_ASPM_L0S_DOWNSTREAM
	default 0x05 if RD890_PCIE_ASPM_L0S_DOWNSTREAM_AND_L1

endif # NORTHBRIDGE_AMD_CIMX_RD890
